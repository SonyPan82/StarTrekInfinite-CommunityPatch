# Bajoran starbases use Cardassian visual assets (Occupation-era architecture).
# Ships fall back to minor_01 via graphical culture fallback.

entity = {
	name = "bajoran_01_starbase_outpost_entity"
}

entity = {
	name = "bajoran_01_starbase_outpost_section_entity"
	locator = { name = "origin" position = { 0 0 0 } }
	attach = { "origin" = "cardassian_01_starbase_outpost_section_entity" }
}

entity = {
	name = "bajoran_01_starbase_starport_entity"
}

entity = {
	name = "bajoran_01_starbase_starport_section_entity"
	locator = { name = "origin" position = { 0 0 0 } }
	attach = { "origin" = "cardassian_01_starbase_starport_section_entity" }
}

entity = {
	name = "bajoran_01_starbase_starhold_entity"
}

entity = {
