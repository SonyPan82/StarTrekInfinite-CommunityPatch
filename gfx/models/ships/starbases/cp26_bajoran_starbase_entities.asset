	locator = { name = "origin" position = { 0 0 0 } }
	attach = { "origin" = "cardassian_01_starbase_starhold_section_entity" }
}

entity = {
	name = "bajoran_01_starbase_starfortress_entity"
}

entity = {
	name = "bajoran_01_starbase_starfortress_section_entity"
	locator = { name = "origin" position = { 0 0 0 } }
	attach = { "origin" = "cardassian_01_starbase_starfortress_section_entity" }
