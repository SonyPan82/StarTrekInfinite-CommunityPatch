entity = {
	name = "bajoran_01_starbase_outpost_construction_entity"
	locator = { name = "base" position = { 0 0 0 } rotation = { -45 0 0 } }
	default_state = "idle"
	state = { name = "idle" state_time = 1
		event = { trigger_once = yes sound = { soundeffect = "place_construction" } }
	}
	attach = { "base" = "cardassian_01_starbase_outpost_construction_base_entity" }
}

entity = {
	name = "bajoran_01_starbase_citadel_construction_entity"
	default_state = "idle"
	state = { name = "idle" state_time = 5
		event = { trigger_once = yes sound = { soundeffect = "place_construction" } }
	}
}

entity = {
	name = "bajoran_01_starbase_turret_section_entity"
	locator = { name = "medium_gun_01" position = { 0 0 0 } }
	locator = { name = "medium_gun_02" position = { 0 0 0 } }
}
