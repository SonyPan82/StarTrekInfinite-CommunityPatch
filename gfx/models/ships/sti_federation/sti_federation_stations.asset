##############################################################################
# STI Federation Shipset — Station Entities
# Adapted from Star Trek New Horizons (688086068)
##############################################################################

@general_scale = 0.85
@reduced_scale = 0.25
@orbital_station = 17
@research_station = 13
@mining_station = 13

################################################################################
# STARBASE ATTACH ENTITIES
################################################################################

entity = {
	name = "sti_federation_starbase_outpost_attach_entity"
	pdxmesh = "sti_federation_outpost_mesh"
}

