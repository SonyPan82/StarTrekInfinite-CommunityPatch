	locator = { name = "part8" 		position = { 0 0 0 } }
	attach = { "root" = "sti_federation_starbase_outpost_attach_entity" }
	default_state = "idle"
	state = { 
		name = "idle"	
		animation = "idle" 
		animation_blend_time = 4 
		start_event = { trigger_once = yes sound = { soundeffect = "starbase_hum_stage_01" } }
