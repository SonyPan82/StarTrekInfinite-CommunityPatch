################################################################################
# STARBASE OUTPOST
################################################################################

entity = {
	name = "sti_federation_starbase_outpost_entity"
	pdxmesh = "master_starbase_root_mesh"
	scale = @reduced_scale
	locator = { name = "part1" 		position = { 0 0 0 } }
	locator = { name = "part2" 		position = { 0 0 0 } }
	locator = { name = "part3" 		position = { 0 0 0 } }
