###################################################################################
# STI Federation Shipset — Invisible Weapon Entities
# All weapons use empty_mesh at tiny scale to hide visible turrets.
# Projectiles/beams emit from turret_muzzle_01 at ship center.
###################################################################################

@weapon_scale = 0.01

# Energy / Laser
entity = {
	name = "sti_federation_small_laser_gun_entity"
	pdxmesh = "empty_mesh"
	state = { name = "idle" }
	state = { name = "attack" looping = no next_state = "idle" }
	scale = @weapon_scale
	locator = { name = "turret_muzzle_01" rotation = { 0 0 0 } }
}
entity = {
	name = "sti_federation_medium_laser_gun_entity"
	pdxmesh = "empty_mesh"
	state = { name = "idle" }
	state = { name = "attack" looping = no next_state = "idle" }
	scale = @weapon_scale
	locator = { name = "turret_muzzle_01" rotation = { 0 0 0 } }
}
entity = {
	name = "sti_federation_large_laser_gun_entity"
	pdxmesh = "empty_mesh"
	state = { name = "idle" }
	state = { name = "attack" looping = no next_state = "idle" }
	scale = @weapon_scale
	locator = { name = "turret_muzzle_01" rotation = { 0 0 0 } }
}

