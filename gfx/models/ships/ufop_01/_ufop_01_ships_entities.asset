@missile_scale = 1.0
@transport_scale = 9.0
@colonizer_scale = 13.0
@science_scale = 1.0
@constructor_scale = 12.0
@military_station_large = 15.0
@orbital_station = 17
@research_station = 13
@mining_station = 13
@terraforming_station = 13

@small_trail_W = 10
@small_trail_L = 60
@medium_trail_W = 25
@medium_trail_L = 150
@large_trail_W = 50
@large_trail_L =  300


###################################################################################
###																				###
###								   CIVILIAN SHIPS								###
###																				###
###################################################################################

entity = {
	name = "ufop_01_colony_ship_entity"
	pdxmesh = "ufop_01_colony_ship_mesh"
		
	default_state = "idle"
	
	state = { name = "idle" animation = "idle" animation_blend_time = 0.0
		
		event = { time = 0 node = "light_locator_01" particle = "navlight_blue_pulse" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "light_locator_02" particle = "navlight_red_small" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "light_locator_03" particle = "navlight_green_small" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "light_locator_04" particle = "navlight_blue_small" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "light_locator_05" particle = "navlight_blue_small" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "light_locator_06" particle = "navlight_blue_small" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "light_locator_07" particle = "navlight_blue_small" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "light_locator_08" particle = "navlight_blue_small" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "light_locator_09" particle = "navlight_blue_small" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "light_locator_10" particle = "navlight_blue_small" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "light_locator_11" particle = "navlight_blue_small" trigger_once = yes keep_particle = yes }
		
		start_event = { trigger_once = yes sound = { soundeffect = "ufop_01_colony_ship_entity" } } 
	}

	state = { name = "death" animation = "death" animation_blend_time = 0.0 chance = 1 looping = no 
		
		event = { time = 0.0 node = "explosion_locator_01" particle = "ignition_small" keep_particle = yes trigger_once = yes sound = { soundeffect = "ignition_small" } }
		event = { time = 2.0 node = "explosion_locator_01" particle = "explosion_small" keep_particle = yes trigger_once = yes sound = { soundeffect = "station_explosion_small" } }
		event = { time = 0.8 node = "explosion_locator_02" particle = "ignition_small" keep_particle = yes trigger_once = yes sound = { soundeffect = "ignition_small" } }
		event = { time = 1.5 node = "explosion_locator_02" particle = "explosion_small" keep_particle = yes trigger_once = yes sound = { soundeffect = "station_explosion_small" } }
		event = { time = 2.0 node = "explosion_locator_03" particle = "explosion_small" keep_particle = yes trigger_once = yes sound = { soundeffect = "station_explosion_small" } }
		event = { time = 3.2 node = "explosion_locator_04" particle = "explosion_small" keep_particle = yes trigger_once = yes sound = { soundeffect = "station_explosion_small" } }
		event = { time = 4.5 node = "explosion_locator_05" particle = "final_explosion_small" keep_particle = yes trigger_once = yes sound = { soundeffect = "final_explosion_small" } }
	}

	state = { name = "warping" animation = "warp_01" animation_speed = 2.0 chance = 3 looping = no  #45fr
		event = { time = 3.0 node = "warp_04" particle = "medium_warpin_effect" trigger_once = yes keep_particle = no }
		event = { time = 0 node = "warp_01" particle = "medium_warpout_effect" trigger_once = yes keep_particle = no sound = { soundeffect = "warpout_effect" }}
		event = { time = 0 node = "warp_02" particle = "medium_warpout_effect" trigger_once = yes keep_particle = no }
	}

	state = { name = "warping" animation = "warp_02" animation_speed = 2.0 chance = 3 looping = no #52fr
		event = { time = 3.50 node = "warp_04" particle = "medium_warpin_effect" trigger_once = yes keep_particle = no }
		event = { time = 0.50 node = "warp_01" particle = "medium_warpout_effect" trigger_once = yes keep_particle = no sound = { soundeffect = "warpout_effect" }}
		event = { time = 0.50 node = "warp_02" particle = "medium_warpout_effect" trigger_once = yes keep_particle = no }
	}

	state = { name = "warping" animation = "warp_03" animation_speed = 2.0 chance = 3 looping = no #67fr
		event = { time = 4.50 node = "warp_04" particle = "medium_warpin_effect" trigger_once = yes keep_particle = no }
		event = { time = 1.50 node = "warp_01" particle = "medium_warpout_effect" trigger_once = yes keep_particle = no sound = { soundeffect = "warpout_effect" }}
		event = { time = 1.50 node = "warp_02" particle = "medium_warpout_effect" trigger_once = yes keep_particle = no }
	}


	locator = { name = "part1" position = { 0 0 0 } }
	scale = 1.0 

}

entity = {
