@cp26_romulan_scimitar_scale = 2.0

entity = {
	name = "cp26_romulan_scimitar_entity"
	pdxmesh = "cp26_romulan_scimitar_mesh"
	scale = @cp26_romulan_scimitar_scale
	default_state = "idle"

	locator = { name = "part1" position = { 0 0 0 } }
	locator = { name = "root" position = { 0 0 0 } }
	locator = { name = "engine_small_01" position = { 5.6 2.45 10.4 } }
	locator = { name = "engine_small_02" position = { -5.6 2.45 10.4 } }
	locator = { name = "large_gun_01" position = { 0 0 0 } }
	locator = { name = "large_gun_02" position = { 0 0 0 } }
	locator = { name = "large_gun_03" position = { 0 0 0 } }
	locator = { name = "large_gun_04" position = { 0 0 0 } }
	locator = { name = "medium_gun_01" position = { 0 0 0 } }
	locator = { name = "medium_gun_02" position = { 0 0 0 } }
	locator = { name = "medium_gun_03" position = { 0 0 0 } }
	locator = { name = "medium_gun_04" position = { 0 0 0 } }

	state = { name = "idle"
		start_event = { trigger_once = yes sound = { soundeffect = "romulan_01_dderidex_entity" } }
	}

	state = { name = "death" chance = 1 looping = no
		event = { time = 0.5 node = "part1" particle = "ship_burn_particle" }
		event = { time = 0.5 node = "part1" particle = "ship_explosion_air_vent_particle" }
		event = { time = 0.0 node = "root" particle = "large_ship_explosion_particle" sound = { soundeffect = ship_destroyed } }
	}

	state = { name = "warping" chance = 1 looping = no
		event = { time = 0 node = "part1" particle = "large_warpout_green_effect" trigger_once = yes keep_particle = no sound = { soundeffect = "warpout_effect" } }
	}

	game_data = {
		trail_width = 3.8
		trail_locators = {
			"engine_small_01" = { width = 3.4 lenght = 30 height = 14 }
			"engine_small_02" = { width = 3.4 lenght = 30 height = 14 }
		}
		size = 33
	}
}
