entity = {
	name = "klingon_01_observation_station_construction_entity"

	locator = { name = "base"				position = { 0	0  0 } rotation = { 45	0  0 }}

	default_state = "idle"

	state = { name = "idle" state_time = 1

			event = { trigger_once = yes sound = { soundeffect = "place_construction" } }
		}

		attach = { "base" = "klingon_01_observation_station_construction_base_entity" }


}

