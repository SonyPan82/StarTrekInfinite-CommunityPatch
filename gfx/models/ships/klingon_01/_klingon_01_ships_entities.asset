		event = { time = 0.2 node = "light_locator_19" particle = "navlight_red_pulse" trigger_once = yes keep_particle = yes }
		event = { time = 0.2 node = "light_locator_20" particle = "navlight_red_pulse" trigger_once = yes keep_particle = yes }
		event = { time = 0.2 node = "light_locator_21" particle = "navlight_red_pulse" trigger_once = yes keep_particle = yes }
		event = { time = 0.2 node = "light_locator_22" particle = "navlight_red_pulse" trigger_once = yes keep_particle = yes }
		event = { time = 0.2 node = "light_locator_23" particle = "navlight_red_pulse" trigger_once = yes keep_particle = yes }
		event = { time = 0.2 node = "light_locator_24" particle = "navlight_red_pulse" trigger_once = yes keep_particle = yes }
		event = { time = 0.2 node = "light_locator_25" particle = "navlight_red_pulse" trigger_once = yes keep_particle = yes }
		event = { time = 0.2 node = "light_locator_26" particle = "navlight_red_pulse" trigger_once = yes keep_particle = yes }
