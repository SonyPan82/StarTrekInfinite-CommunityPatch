	pdxmesh = "klingon_01_military_station_mesh"

	# CP26 fix (2026-05-14) : missing part1/part2 locators caused heap corruption
	# and SIGABRT during CullAndUpdateEntitiesRecursive after enough render passes.
	# Vanilla had part1 commented out; engine actually queries part2 → adding both.
	locator = { name = "part1" 			position = { 0 0 0 } }
	locator = { name = "part2" 			position = { 0 0 0 } }

	default_state = "idle"

	state = { name = "idle" animation = "idle" animation_blend_time = 0.0
	
		start_event = { trigger_once = yes sound = { soundeffect = "klingon_01_military_station_entity" } }
		
		event = { time = 0 node = "light_locator_01" particle = "navlight_red" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "light_locator_02" particle = "navlight_red" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "light_locator_03" particle = "navlight_red" trigger_once = yes keep_particle = yes }
