##############################################################################
# STI Fleet Museum  -  Megastructure Entities
##############################################################################

# --- Historic ship section entities (NX + Constitution refit + Brel only; Sarajevo / Discovery / Emette / Intrepid removed) ---

entity = {
	name = "sti_museum_nx_section_1_entity"
	pdxmesh = "sti_museum_nx_section_1_mesh"
	scale = 0.36
	default_state = "idle"
	state = { name = "idle" state_time = 5 }
	state = { name = "death" state_time = 2 looping = no
		event = { time = 1.9 particle = "large_station_explosion_particle" keep_particle = yes trigger_once = yes sound = { soundeffect = "station_explosion_large" } }
	}
}


entity = {
	name = "sti_museum_brel_entity"
	pdxmesh = "klingon_01_birdofprey_mesh"
	scale = 0.72
	default_state = "idle"
	state = { name = "idle" animation = "idle" animation_blend_time = 0.0 }
	state = { name = "death" state_time = 2 looping = no
		event = { time = 1.9 particle = "large_station_explosion_particle" keep_particle = yes trigger_once = yes sound = { soundeffect = "station_explosion_large" } }
	}
}

entity = {
	name = "sti_museum_constitution_refit_raw_entity"
	pdxmesh = "cp26_museum_constitution_tos_mesh"
	scale = 1.00
	default_state = "idle"
	state = { name = "idle" state_time = 5 }
	state = { name = "death" state_time = 2 looping = no
		event = { time = 1.9 particle = "large_station_explosion_particle" keep_particle = yes trigger_once = yes sound = { soundeffect = "station_explosion_large" } }
	}
}

entity = {
	name = "sti_museum_constitution_refit_entity"
	locator = {
		name = "root"
		position = { 0.1 0 0 }
		rotation = { 0 0 0 }
	}
	attach = { "root" = "sti_museum_constitution_refit_raw_entity" }
	default_state = "idle"
	state = { name = "idle" state_time = 5 }
}

