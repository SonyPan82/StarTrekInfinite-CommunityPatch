# --- Fleet Museum station (with ships attached) ---

entity = {
	name = "sti_fleet_museum_entity"
	pdxmesh = "sti_fleet_museum_mesh"
	attach = { "part3" = "sti_museum_brel_entity" }
	attach = { "part4" = "sti_museum_nx_section_1_entity" }
	attach = { "part2" = "sti_museum_constitution_refit_entity" }
	default_state = "idle"
	state = { name = "idle" state_time = 5 }
	state = { name = "death" state_time = 2 looping = no
		event = { time = 1.9 particle = "large_station_explosion_particle" keep_particle = yes trigger_once = yes sound = { soundeffect = "station_explosion_large" } }
	}
	scale = 0.75

	game_data = { size = 20.0 }
}

# --- Stage 2: Museum + Enterprise-D (Galaxy) ---
# Galaxy remplace la Constitution au pod haut-gauche (part2)
# Constitution deplacee au pod bas-gauche (part1)

