entity = {
	name = "cardassian_01_colony_ship_entity"
	pdxmesh = "cardassian_01_colony_ship_mesh"
		
	default_state = "idle"

	state = { name = "idle" animation = "idle" animation_blend_time = 0.0
#		
		event = { time = 0 node = "light_locator_01" particle = "navlight_orange_breathe_small" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "light_locator_02" particle = "navlight_orange_breathe_small" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "light_locator_03" particle = "navlight_orange_breathe_small" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "light_locator_04" particle = "navlight_orange_breathe_small" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "light_locator_05" particle = "navlight_orange_breathe_small" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "light_locator_06" particle = "navlight_orange_small" trigger_once = yes keep_particle = yes }
		event = { time = 0.2 node = "light_locator_07" particle = "navlight_orange_small" trigger_once = yes keep_particle = yes }
		event = { time = 0.4 node = "light_locator_08" particle = "navlight_orange_small" trigger_once = yes keep_particle = yes }
		event = { time = 0.8 node = "light_locator_09" particle = "navlight_orange_small" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "light_locator_10" particle = "navlight_orange_breathe_small" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "light_locator_11" particle = "navlight_orange_breathe_small" trigger_once = yes keep_particle = yes }
#		
		start_event = { trigger_once = yes sound = { soundeffect = "cardassian_01_colony_ship_entity" } } 
	}

	state = { name = "death" animation = "death" animation_blend_time = 0.0 chance = 1 looping = no 
		
		event = { time = 0.0 node = "explosion_locator_01" particle = "ignition_small" keep_particle = yes trigger_once = yes sound = { soundeffect = "ignition_small" }}
		event = { time = 2.0 node = "explosion_locator_01" particle = "explosion_small" keep_particle = yes trigger_once = yes sound = { soundeffect = "station_explosion_small" } }
		event = { time = 0.8 node = "explosion_locator_02" particle = "ignition_small" keep_particle = yes trigger_once = yes sound = { soundeffect = "ignition_small" } }
		event = { time = 1.5 node = "explosion_locator_02" particle = "explosion_small" keep_particle = yes trigger_once = yes sound = { soundeffect = "station_explosion_small" } }
		event = { time = 2.0 node = "explosion_locator_03" particle = "explosion_small" keep_particle = yes trigger_once = yes sound = { soundeffect = "station_explosion_small" } }
		event = { time = 3.2 node = "explosion_locator_04" particle = "explosion_small" keep_particle = yes trigger_once = yes sound = { soundeffect = "station_explosion_small" } }
		event = { time = 4.5 node = "explosion_locator_05" particle = "final_explosion_small" keep_particle = yes trigger_once = yes sound = { soundeffect = "final_explosion_small" } }
	}

	state = { name = "warping" animation = "warp_01" animation_speed = 2.0 chance = 3 looping = no  #45fr
		event = { time = 3.0 node = "warp_04" particle = "small_warpin_orange_effect" trigger_once = yes keep_particle = no }
		event = { time = 0 node = "warp_01" particle = "small_warpout_orange_effect" trigger_once = yes keep_particle = no sound = { soundeffect = "warpout_effect" }}
		event = { time = 0 node = "warp_02" particle = "small_warpout_orange_effect" trigger_once = yes keep_particle = no }
	}

	state = { name = "warping" animation = "warp_02" animation_speed = 2.0 chance = 3 looping = no #52fr
		event = { time = 3.50 node = "warp_04" particle = "small_warpin_orange_effect" trigger_once = yes keep_particle = no }
		event = { time = 0.50 node = "warp_01" particle = "small_warpout_orange_effect" trigger_once = yes keep_particle = no sound = { soundeffect = "warpout_effect" }}
		event = { time = 0.50 node = "warp_02" particle = "small_warpout_orange_effect" trigger_once = yes keep_particle = no }
	}

	state = { name = "warping" animation = "warp_03" animation_speed = 2.0 chance = 3 looping = no #67fr
		event = { time = 4.50 node = "warp_04" particle = "small_warpin_orange_effect" trigger_once = yes keep_particle = no }
		event = { time = 1.50 node = "warp_01" particle = "small_warpout_orange_effect" trigger_once = yes keep_particle = no sound = { soundeffect = "warpout_effect" }}
		event = { time = 1.50 node = "warp_02" particle = "small_warpout_orange_effect" trigger_once = yes keep_particle = no }
	}

	scale = 1.7
}

