@general_scale = 1.0

@corvette_scale = 3.2
@saber_scale = 5.3
@sovereign_scale = 6.2
@steamrunner_scale = 6.6
@adv_cruiser_scale = 8.2
@strike_scale = 2.8
@assault_cruiser_scale = 10.8
@exploration_cruiser_scale = 8.0
@transport_scale = 0.5
@colonizer_scale = 0.5
@science_scale = 13.6
@constructor_scale = 0.5
@military_station_large = 15.0
@orbital_station = 17
@research_station = 13
@mining_station = 13
@terraforming_station = 13


