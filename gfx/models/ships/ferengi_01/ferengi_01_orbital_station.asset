		event = { time = 2.83 node = "ship_main" particle = "ship_explosion_particle" sound = { soundeffect = ship_destroyed } }
		event = { time = 3.26 node = "ship_main" particle = "ship_explosion_particle" sound = { soundeffect = ship_destroyed } }
