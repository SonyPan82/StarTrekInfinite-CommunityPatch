@general_scale = 1.0
@dominion_01_shuttle_scale = 7.5
@dominion_01_attack_ship_scale = 6.5

entity = {
	name = "dominion_01_bomber_entity"	
	pdxmesh = "dominion_01_corvette_coreA_mesh"
	scale = 0.2
}

entity = {
	name = "dominion_01_fighter_entity"	
	pdxmesh = "dominion_01_corvette_coreA_mesh"
	scale = 0.15
}


