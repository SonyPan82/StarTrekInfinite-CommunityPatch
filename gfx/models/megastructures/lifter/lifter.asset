@scale_correct = 10
# Parts
entity = {
	name = "lifter_1_entity"
	pdxmesh = "lifter_01_mesh"
	scale = @scale_correct
	default_state = "idle"
	state = { name = "idle" }
}

entity = {
	name = "lifter_2_entity"
	pdxmesh = "lifter_02_mesh"
