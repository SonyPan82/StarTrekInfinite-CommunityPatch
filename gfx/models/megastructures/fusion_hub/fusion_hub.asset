	default_state = "idle"
	state = { name = "idle" }
    game_data = {
        uv_animation_direction = { 1 1 }
        uv_animation_speed = 0.3
        emissive_recolor_crunch = 2.5
        bloom_factor = 0.4
    }
}

# Assembly
entity = {
	name = "fusion_hub_01_entity"
	pdxmesh = "fusion_hub_collider_mesh"
	cull_radius = 100000
					
	default_state = "idle"
	state = { name = "idle" 
		start_event = { node = "effect_1" particle = "matde_core_beam_effect" keep_particle = yes trigger_once = yes }
	}
	locator = { name = "root" 	position = { 0 0 0 } }
	locator = { name = "effect_1" position = { 0 330 0 } scale = 3.5 }

    attach = { root = fusion_hub_1_entity }
}

