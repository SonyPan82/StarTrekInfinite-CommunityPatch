#H = { 253 169 38 }	Tooltip orange
#color = 0xffffffff	#format is 0xaarrggbb
#G = { 41 225 38 255 } #format is red green blue alpha
#textcolors = {} is global for all fonts. changing this in one font will also change it for all others
# L = Lore text, not relevant game info, just fun to know backstory info
# G = Green, used for numbers that are positiv modifiers		
# R = Red, used for negative modifier 
# Y = Yellow, to be used for stuff that is sub optimal or for certain highlights
# H = Highlight, Orange in Game
# T = Text, standard for all text, to be used if ALL text needs tweaking
# E = Standard green, used with large chunks of texts, such as events and advisor
# S = Subtitle highlight (light green in this case)
# M = Magenta. Indicator for "Rare Techs".
