@dynamic_extra = 0

guiTypes = {
	containerWindowType = {
		name = "megastructure_selection_window"
		orientation = center
		origo = center
		size = { width = 345 height = 500 }
		dynamic_extra_height = @dynamic_extra
		
		moveable = yes
		
		background = {
			name = "megastructure_selection_window_background"
			spriteType = "GFX_generic_bg_windows"
		}
		
		# iconType = {
		# 	name = "hex_bg"
		# 	spriteType = "GFX_hex_bg"
		# 	position = { x = -10 y = -13 }
		# 	alwaysTransparent = yes
		# }
		
		buttonType = {
			name = "header_line"
			quadTextureSprite = "GFX_header_line"
			themeable = player
			size = { x = 300 y = 4 }
			position = { x = 14 y = 40 }
			alwaystransparent = yes
		}
		
		instantTextBoxType={
			name = "title"
			position = { x = 0 y = 15 }
			font = "Font_rebelton_18"
			text = "MEGASTRUCTURE_SELECTION_PICK_TYPE"
			maxWidth = 340
			maxHeight = 40
			fixedSize = yes
			format = center
		#	vertical_alignment = center
		#	text_color_code = "H"
		}
		
		buttonType = {
			name = "close"
			quadTextureSprite = "GFX_UI_Button_Close"
			position = { x= -42 y = 12  }
			Orientation = "UPPER_RIGHT"
			shortcut = "ESCAPE"
			pdx_tooltip = "CLOSE_TITLE"
			clicksound = "back_click"
			actionShortcut = "cancel"
		}
		
		containerWindowType = {
			name = "leader_frame_box"
			size = { width = 320 height = 438 }
			position = { x = 10 y = 50 }
			
			background = {
				name = "leader_frame"
				spriteType = "GFX_tile_4_b"
				alwaysTransparent = no
			}
		}
		
		smoothListboxType = {
			name = "entries"
			position = { x = 20 y = 60 }
			size = { x = 295 y = 415 }
			borderSize = { x = 0 y = 0 }
			orientation = "UPPER_LEFT"
			scrollbartype = "standardlistbox_slider"
			scrollbar_themeable = player
			autohide_scrollbar = yes
		}
	}
	
	containerWindowType = {
		name = "megastructure_selection_window_entry"
		size = { width = 294 height = 112 }
		
		background = {
			name = "megastructure_selection_window_entry_background"
			spriteType = "GFX_tile_1_b"
			clicksound = "confirmation"
		}

		containerWindowType = {
            name = "selected"
            position = { x = 0 y = 0 }
            size = { width = 100% height = 100% }
            background = {
                name = "selected_bg"
                spriteType = "GFX_glow_tile_orange_no_padding"
                alwaysTransparent = yes
            }
        }
		
		instantTextBoxType={
			name = "name"
			position = { x = 0 y = 5 }
			font = "cg_16b"
			text = "STATION_NAME"
			maxWidth = 290
			maxHeight = 20
			fixedSize = yes
			format = center
			text_color_code = "E"
		}
		
		instantTextBoxType={
			name = "desc"
			position = { x = 0 y = 25 }
			font = "cg_16b"
			text = "STATION_DESC"
			maxWidth = 290
			maxHeight = 40
			fixedSize = yes
			format = center
		}
		
		instantTextBoxType={
			name = "details"
			position = { x = 5 y = 45 }
			font = "cg_16b"
			maxWidth = 280
			maxHeight = 40
			fixedSize = no
			format = center
		}
	}
}