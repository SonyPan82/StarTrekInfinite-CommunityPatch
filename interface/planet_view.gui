	}

	@window_w = 900

	containerWindowType = {
		name = "planet_view"
		orientation = upper_left
		size = { width = @window_w height = 870 }
		moveable = yes
		position = { x = 400 y = 95 }
		clipping = no

		if_resolution = {
			max_height = 800
			size = { width = 900 height = 890 }
			show_position = { x = 42 y = 0 }
			hide_position = { x = -800 y = 0 }
			animation_time = 200
			animation_type = decelerated
			show_sound = "select_click"
			moveable = no
		}

		background = {
			name = "background"
			quadTextureSprite ="GFX_generic_bg_windows"
		}

		background = {
			name = "gradient"
