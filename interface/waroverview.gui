		}
		iconType ={
			name ="war_type_icon"
			quadTextureSprite = "GFX_icon_war_type_wg_coup_defense"
			position = { x = -25 y = -9 }
			scale = 0.42
			alwaysTransparent = yes
		}
		iconType ={
			name ="attacker_icon"
			spriteType = "GFX_icon_war_approach_attacker"
			position = { x = 35 y = -5 }
			alwaysTransparent = no
		}
