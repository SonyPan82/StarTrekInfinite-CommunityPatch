guiTypes = {
	@window_width = 750

	containerWindowType = {
		name = "government_view"
		size = { width = @window_width height = 685 }
		show_position = { x = 42 y = 146 }
		hide_position = { x = -750 y = 146 }
		animation_time = 200
		animation_type = decelerated
		show_sound = sidebar_window

		background = {		
			name = "background"
			quadTextureSprite = "GFX_generic_bg_windows"			
		}

		background = {
			name = "gradient"
