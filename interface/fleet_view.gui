						position = { x = @button_square_x y = 17 }
						alwaysTransparent = yes
						scale = 1.3
						frame = 1
					}
					buttonType = {
						name = "prioritize_operative_capacity"
						quadTextureSprite = "GFX_button_tile_dropdown"
						position = { x = @button_x y = @[button_y + button_spacing * 1 + button_h * 1] }
						size = { x = @button_w y = @button_h }
					}
					instantTextBoxType = {
						name = "priority_label_operative"
						font = "cg_16b"
						text = "PRIORITIZATION_TYPE_OPERATIVE_CAPACITY"
						alwaysTransparent = no
						format = left
						maxWidth = 170
						position = { x = @[button_x + button_label_x] y = @[button_y + button_spacing * 1 + button_h * 1 + button_label_y] }
						alwaysTransparent = yes
