						name = "priority_label_unprioritize"
						font = "cg_16b"
						text = "PRIORITIZATION_TYPE_UNPRIORITIZED"
						alwaysTransparent = no
						format = left
						maxWidth = 170
						position = { x = @[button_x + button_label_x] y = @[button_y + button_label_y] }
						alwaysTransparent = yes
					}
					iconType = {
						name = "color_square_unprioritize"
